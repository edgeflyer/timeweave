# ============== 应用 ==============
APP_ENV=development          # development | staging | production
APP_PORT=8080
LOG_LEVEL=info              # debug | info | warn | error

# ============== MySQL ==============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=questos

# ============== JWT ==============
# 生产环境必须用强随机串覆盖（生成：openssl rand -hex 32）
JWT_SECRET=please-replace-with-a-real-secret-min-16-chars
JWT_TTL=24h